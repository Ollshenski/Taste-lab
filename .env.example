# Copy to .env on the server and fill in. Never commit .env.

# Your domain, without https:// (used by Caddy for the certificate)
DOMAIN=taste-lab.ge
# Public address of the shop, used for Flitt callback/return URLs
PUBLIC_URL=https://taste-lab.ge

# Admin password used on the very first start (change it later in the panel)
ADMIN_PASSWORD=change-me-to-something-long

# Flitt (Merchant Portal → Technical settings). Start with the public test merchant:
#   FLITT_MERCHANT_ID=1549901  FLITT_SECRET_KEY=test
FLITT_MERCHANT_ID=
FLITT_SECRET_KEY=

# Order emails through the shop mailbox (Zoho). Port 587: Hetzner blocks 25 and 465.
# With two-factor login on Zoho, SMTP_PASS must be an app password (Zoho account → Security → App passwords).
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=587
SMTP_USER=sandro@taste-lab.ge
SMTP_PASS=
ORDER_NOTIFY_TO=sandro@taste-lab.ge
